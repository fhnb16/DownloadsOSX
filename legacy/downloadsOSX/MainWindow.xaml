<Window x:Class="downloadsOSX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="570" Width="312" Name="window" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Topmost="False" ShowInTaskbar="True" BorderThickness="1"
        BorderBrush="#2A9D9D9D" Deactivated="window_Deactivated"
        WindowState="Normal" Activated="window_Activated"
        Icon="/downloads;component/Images/Downloads.png"
        AllowsTransparency="False" Title="{DynamicResource m_Title}"
        MinWidth="312" MaxWidth="312" MinHeight="570" MaxHeight="570" Foreground="Black"
        Closing="window_Closing" FontFamily="../Fonts/#Ubuntu" FontWeight="Regular">
    <Grid>
        <Rectangle Name="windowPlane" MouseDown="window_MouseDown" Stroke="#00000000" ScrollViewer.VerticalScrollBarVisibility="Disabled" >
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.3,1" StartPoint="0.7,0">
                    <GradientStop x:Name="furry" Color="#FF303030" Offset="0"/>
                    <GradientStop x:Name="accent" Color="#FF303030" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <ListView Margin="12" Name="filesView" SelectionMode="Single" Background="#0B868686"
                  BorderBrush="#0A000000" Foreground="White" ItemsSource="{Binding}" DragOver="filesView_DragOver" MouseUp="filesView_MouseUp" ScrollViewer.CanContentScroll="False" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel KeyDown="DockPanel_KeyDown" Orientation="Vertical" Cursor="Hand" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseDoubleClick" Handler="filesView_MouseDoubleClick"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True" Width="Auto">
                        <TextBlock x:Name="kebab" DockPanel.Dock="Right" Text="{Binding Name}" TextWrapping="WrapWithOverflow"
                                   TextTrimming="CharacterEllipsis" Width="222" Height="35"
                                   FontSize="15" ToolTip="{Binding Name}" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Left" Padding="5,0,0,0" FontFamily="../Fonts/#Ubuntu">
                            <TextBlock.Effect>
                                <DropShadowEffect
                              ShadowDepth="1"
                              Direction="330"
                              Color="Black"
                              Opacity="0.9"
                             BlurRadius="3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Image Height="50" Width="50" Source="{Binding Image}" Stretch="Uniform" />
                    </DockPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Image Height="21" Name="menuBtn" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="21" Source="/Downloads;component/Images/menu.png" Cursor="Hand" MouseDown="menuBtn_MouseDown" Margin="0,0,-16,-3" Opacity="0.64">
            <Image.RenderTransform>
                <RotateTransform Angle="90" />
            </Image.RenderTransform>
        </Image>
        <Image Height="21" Name="menuBtn2" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="21" Source="/Downloads;component/Images/menu.png" Cursor="Hand" MouseDown="menuBtn_MouseDown" Margin="0,0,-24,-16" Opacity="0.64">
            <Image.RenderTransform>
                <RotateTransform Angle="180" />
            </Image.RenderTransform>
        </Image>
        <Button Content="{DynamicResource upAv}" HorizontalAlignment="Right" Name="upgradeBtn" Width="Auto" Height="23" VerticalAlignment="Top" IsDefault="False" Background="#A52991B1" Padding="5,2" Foreground="#E6FFFFFF" BorderBrush="#70000000" Click="upgradeBtn_Click" />
        <Image Height="21" x:Name="menuBtn2_Copy" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="21" Source="Images/menu_Inv.png" Cursor="Hand" MouseDown="menuBtn_MouseDown" Margin="0,0,-26,-18" Opacity="0.32">
            <Image.RenderTransform>
                <RotateTransform Angle="180" />
            </Image.RenderTransform>
        </Image>
        <Image Height="21" x:Name="menuBtn_Copy" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="21" Source="Images/menu_Inv.png" Cursor="Hand" MouseDown="menuBtn_MouseDown" Margin="0,0,-18,-5" Opacity="0.32">
            <Image.RenderTransform>
                <RotateTransform Angle="90" />
            </Image.RenderTransform>
        </Image>
        <Image x:Name="menuBtn3_Copy" Stretch="Fill" HorizontalAlignment="Right" Width="32" Source="Images/pinTen.png" Cursor="Hand" MouseDown="menuBtn_MouseDown" Margin="0" VerticalAlignment="Bottom" Panel.ZIndex="100" Height="32" Opacity="0.01"/>
    </Grid>
    <Window.Resources>
        <ContextMenu FontFamily="../Fonts/#Ubuntu" Name="appMenu" x:Key="menuButton">
            <MenuItem Header="{DynamicResource openDownloadsBtn}" Name="openDownloadsItem" Click="openDownloadsItem_Click" >
                <MenuItem.Icon>
                    <Image Source="Images/icons/folder-download-fill.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource aboutBtn}" Name="aboutItem" Click="aboutItem_Click" >
                <MenuItem.Icon>
                    <Image Source="Images/icons/global-fill.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource helpBtn}" Name="helpItem" Click="helpItem_Click" >
                <MenuItem.Icon>
                    <Image Source="Images/icons/settings-2-fill.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource collapseBtn}" Name="minimizeItem" Click="minimizeItem_Click" >
                <MenuItem.Icon>
                    <Image Source="Images/icons/space.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource exitBtn}" Name="exitItem" Click="exitItem_Click" >
                <MenuItem.Icon>
                    <Image Source="Images/icons/close-circle-fill.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
</Window>
