                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterY="0.5" CenterX="0.5"/>
                        <RotateTransform Angle="64" CenterY="0.5" CenterX="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF001E53" Offset="1"/>
                <GradientStop Color="#FF5F0000"/>
            </LinearGradientBrush>
        </Grid.Background>/-->
        <TextBlock x:Name="labelNewV" Text="New version available!" Margin="10,3" Padding="5,0" Height="16" Foreground="Black"  />
        <TextBlock x:Name="label_versions" Text="Current: 0.1, new version: 0.2" Margin="10,3" Padding="5,0,5,2" Height="18" Grid.Row="1" Foreground="Black"  />
        <Button x:Name="updateBtn" Content="Update Now" Margin="6,3" Padding="-1" Click="UpdateBtn_Click" Cursor="Hand" Grid.Row="3"/>



