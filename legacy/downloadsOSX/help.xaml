<Window x:Class="downloadsOSX.help"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource help_Title}" Height="262" Width="668" WindowStyle="ToolWindow"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated" Loaded="Window_Loaded" FontFamily="../Fonts/#Ubuntu" FontWeight="Regular">
    <Grid>
        <GroupBox Header="{DynamicResource taskBarPin}" Margin="12,5,0,7" Name="groupBox1" HorizontalAlignment="Left" Width="353" BorderBrush="#11000000">
            <Grid>
                <TabControl HorizontalAlignment="Left" Margin="6,6,0,8" Name="tabControl1" Width="329" TabStripPlacement="Bottom">
                    <TabItem Header="Windows 8, 8.1,10" IsSelected="True">
                        <Grid>
                            <Image Name="image1" Stretch="Uniform" Width="312" Source="/Downloads;component/Images/pinTen.png" Margin="6,0,6,5" Height="87" VerticalAlignment="Bottom" />
                            <TextBlock Height="59" Margin="1,1,1,0" Name="textBlock1" Text="{DynamicResource taskBarPinDesc}" TextWrapping="WrapWithOverflow"
                                   TextTrimming="WordEllipsis"  VerticalAlignment="Top" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Windows Vista, 7" Name="tabItem1" IsSelected="False">
                        <Grid>
                            <Image Name="image2" Stretch="Uniform" Width="312" Source="/Downloads;component/Images/pinSeven.png" Margin="6,0,6,5" Height="87" VerticalAlignment="Bottom" />
                            <TextBlock Height="51" Margin="1,1,1,0" Name="textBlock2" Text="{DynamicResource taskBarPinDesc}" TextWrapping="WrapWithOverflow"
                                   TextTrimming="WordEllipsis"  VerticalAlignment="Top" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Windows 11" Name="tabItem2" IsSelected="False">
                        <Grid>
                            <Image Name="image3" Stretch="Uniform" Width="312" Source="Images/pin.png" Margin="6,0,6,5" Height="87" VerticalAlignment="Bottom" />
                            <TextBlock Height="51" Margin="1,1,1,0" Name="textBlock4" Text="{DynamicResource taskBarPinDesc}" TextWrapping="WrapWithOverflow"
                                   TextTrimming="WordEllipsis"  VerticalAlignment="Top" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </GroupBox>
        <GroupBox Header="{DynamicResource autoStartAdd}" Margin="0,5,12,7" Name="groupBox2" HorizontalAlignment="Right" Width="269" BorderBrush="#11000000">
            <Grid>
                <Button Content="{DynamicResource autoStartBtn}" Height="35" Margin="6,0,6,6" Name="button1" VerticalAlignment="Bottom" Click="button1_Click" />
                <TextBlock Height="137" Margin="6,6,6,0" Name="textBlock3" Text="{DynamicResource autoStartDesc}" VerticalAlignment="Top" TextTrimming="WordEllipsis" TextWrapping="Wrap" Padding="5" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
