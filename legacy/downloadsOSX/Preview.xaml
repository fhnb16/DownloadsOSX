<Window x:Class="downloadsOSX.Preview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource previewTitle}" Height="374" Width="571"
        KeyDown="Window_KeyDown" Icon="/Downloads;component/Images/icon-image.png"
        Deactivated="Window_Deactivated" Closing="Window_Closing" ShowInTaskbar="False"
        Topmost="False" Loaded="Window_Loaded" ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow" LostFocus="Window_LostFocus"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown"
        BorderBrush="#2A9D9D9D" Activated="Window_Activated">
    <Grid>
        <Image Name="image1" Stretch="Uniform" MouseWheel="image1_MouseWheel" MouseDown="image1_MouseDown" />
    </Grid>
</Window>
