<Application x:Class="DownloadsOSX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] English strings (always loaded, fallback for missing keys) -->
                <ResourceDictionary Source="Resources/Strings.en.xaml" />
                <!-- [1] Language overlay, replaced at runtime -->
                <ResourceDictionary />
                <!-- [2] Theme (inserted by ThemeService) -->
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="App.FontFamily">Segoe UI</FontFamily>
            <FontFamily x:Key="App.MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
