<Window x:Class="DownloadsOSX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:v="clr-namespace:DownloadsOSX.Views"
        Title="{DynamicResource AppTitle}"
        Width="340" SizeToContent="Height" MinHeight="160"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Icon="/Downloads;component/Assets/Downloads.ico"
        FontFamily="{DynamicResource App.FontFamily}" FontSize="{DynamicResource App.FontSize}"
        Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True">

    <Window.Resources>
        <sys:Double x:Key="Stack.ThumbSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">44</sys:Double>
        <sys:Double x:Key="Stack.TileMinWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">100</sys:Double>
        <sys:Double x:Key="Stack.TileThumbSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">64</sys:Double>
        <sys:Double x:Key="Stack.NameMaxHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>
        <Visibility x:Key="Stack.DetailsVisibility">Visible</Visibility>

        <!-- List row -->
        <DataTemplate x:Key="ListItemTemplate">
            <Grid x:Name="Root" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="{DynamicResource Stack.ThumbSize}" Height="{DynamicResource Stack.ThumbSize}" VerticalAlignment="Center">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse x:Name="NewDot" Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" Stroke="{DynamicResource Brush.Solid}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="{DynamicResource Stack.NameMaxHeight}" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="900" />
                    <TextBox x:Name="RenameBox" Visibility="Collapsed" Padding="4,2" MinHeight="0"
                             KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus" IsVisibleChanged="RenameBox_IsVisibleChanged" />
                    <TextBlock x:Name="DetailsText" Text="{Binding Details}" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{DynamicResource Stack.DetailsVisibility}" />
                    <TextBlock x:Name="SourceText" Text="{Binding SourceLabel}" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource Brush.TextTertiary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="NewDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceLabel}" Value="{x:Null}">
                    <Setter TargetName="SourceText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grid tile -->
        <DataTemplate x:Key="GridItemTemplate">
            <StackPanel x:Name="Root" HorizontalAlignment="Stretch" Background="Transparent" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="900">
                <Grid Width="{DynamicResource Stack.TileThumbSize}" Height="{DynamicResource Stack.TileThumbSize}" HorizontalAlignment="Center" Margin="0,2,0,4">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse x:Name="NewDot" Width="9" Height="9" Fill="{DynamicResource Brush.Accent}" Stroke="{DynamicResource Brush.Solid}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="NameText" Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource App.FontSizeSmall}" MaxHeight="{DynamicResource Stack.NameMaxHeight}" />
                <TextBox x:Name="RenameBox" Visibility="Collapsed" Padding="2" MinHeight="0" FontSize="{DynamicResource App.FontSizeSmall}"
                         KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus" IsVisibleChanged="RenameBox_IsVisibleChanged" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="NewDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel">
            <v:TilePanel MinItemWidth="{DynamicResource Stack.TileMinWidth}" />
        </ItemsPanelTemplate>

        <GroupStyle x:Key="DateGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" Margin="8,10,0,3" />
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ShowShift" />
        </Grid.RenderTransform>

        <!-- Header (draggable caption) -->
        <Grid x:Name="Header" Height="46" Margin="14,2,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TitleButton" Style="{StaticResource Button.Link}" Foreground="{DynamicResource Brush.Text}" Click="OpenFolder_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource OpenFolder}">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" Text="{DynamicResource AppTitle}" />
                </Button>
                <TextBlock x:Name="CountText" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="8,3,0,0" TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UpdatePill" Style="{StaticResource Button.Pill}" Visibility="Collapsed" Click="UpdatePill_Click" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Update}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.AccentText}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" StrokeThickness="1.6" />
                        <TextBlock x:Name="UpdatePillText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="MenuButton" Style="{StaticResource Button.Icon}" Click="MenuButton_Click" ToolTip="{DynamicResource Menu}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Icon.More}" Style="{StaticResource IconPath}" StrokeThickness="2.3" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Type-to-filter bar -->
        <Border x:Name="FilterBar" Grid.Row="1" Visibility="Collapsed" Margin="12,0,12,6" Padding="8,4,4,4" CornerRadius="5"
                Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,2">
            <DockPanel>
                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="24" Height="24" Click="ClearFilter_Click">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" />
                </Button>
                <TextBlock x:Name="FilterText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Items -->
        <ListView x:Name="List" Grid.Row="2" Margin="6,0,6,0" Background="Transparent" BorderThickness="0" Padding="0"
                  ItemContainerStyle="{StaticResource StackItem}" SelectionMode="Extended"
                  ItemTemplate="{StaticResource ListItemTemplate}" ItemsPanel="{StaticResource ListPanel}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False"
                  AllowDrop="False" FocusVisualStyle="{x:Null}"
                  PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" MouseDoubleClick="List_MouseDoubleClick"
                  PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp" SelectionChanged="List_SelectionChanged">
            <ListView.Template>
                <ControlTemplate TargetType="ListView">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListView.Template>
        </ListView>

        <!-- Empty / missing folder -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" Margin="24,28,24,36" HorizontalAlignment="Center">
            <Path Data="{StaticResource Icon.Download}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.TextTertiary}"
                  Width="40" Height="40" Stretch="Uniform" StrokeThickness="1.2" Margin="0,0,0,10" />
            <TextBlock x:Name="EmptyText" Text="{DynamicResource EmptyFolder}" Foreground="{DynamicResource Brush.TextSecondary}"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Separator}" Margin="14,6,14,0" Padding="0,7,0,10">
            <DockPanel>
                <TextBlock x:Name="FooterHint" DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" Text="{DynamicResource FooterHint}" />
                <Button Style="{StaticResource Button.Link}" Click="OpenFolder_Click" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource OpenInExplorer}" />
                        <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.Accent}"
                              Width="12" Height="12" Stretch="Uniform" Margin="4,1,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.RowSpan="4" VerticalAlignment="Bottom" Margin="12,0,12,46" Visibility="Collapsed" Opacity="0"
                Background="{DynamicResource Brush.Toast}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                CornerRadius="6" Padding="12,9" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.2" Direction="270" />
            </Border.Effect>
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
