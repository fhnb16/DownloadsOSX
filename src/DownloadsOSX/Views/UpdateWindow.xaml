<Window x:Class="DownloadsOSX.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource UpdateTitle}"
        Width="460" SizeToContent="Height" MaxHeight="620"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Icon="/Downloads;component/Assets/Downloads.ico"
        FontFamily="{DynamicResource App.FontFamily}" FontSize="{DynamicResource App.FontSize}"
        Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True">
    <Grid Margin="20,8,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Caption}" Click="Later_Click" Margin="0,0,-14,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" />
            </Button>
            <TextBlock Text="{DynamicResource UpdateTitle}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Downloads;component/Assets/Images/Downloads.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Headline" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                <TextBlock x:Name="Versions" Style="{StaticResource Text.Secondary}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" x:Name="NotesCard">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Notes" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Style="{StaticResource Button.Link}" Content="{DynamicResource SkipVersion}" Click="Skip_Click" VerticalAlignment="Center" />
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Content="{DynamicResource InstallUpdate}" Click="Install_Click" MinWidth="120" IsDefault="True" />
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="{DynamicResource Later}" Click="Later_Click" Margin="0,0,8,0" MinWidth="90" />
        </DockPanel>
    </Grid>
</Window>
